# Excel files sono binari (no diff, no merge)
*.xlsx binary
*.xlsm binary
*.xls  binary
*.xlsb binary

# VBA exports sono testo Windows-style (line endings CRLF)
*.bas  text eol=crlf linguist-language=VBA
*.cls  text eol=crlf linguist-language=VBA
*.frm  text eol=crlf linguist-language=VBA

# SQL files
*.sql  text
*.sql  linguist-detectable=true

# Notebook Jupyter (testo JSON ma trattalo con cura)
*.ipynb text
